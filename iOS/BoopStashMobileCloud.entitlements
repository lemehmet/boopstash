<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The iOS app with iCloud (ADR 0008), for builds that embed a provisioning
  profile: fastlane's ios lanes select it with BOOPSTASH_ENTITLEMENTS and
  set BOOPSTASH_ICLOUD=YES. Simulator and CI builds have no entitlements.
  - iCloud with CloudKit, the app's own container only: sync (ADR 0002),
    off until the user turns it on.
  - aps-environment: CloudKit's change notifications.
  - The App Group the share extension writes notes into (#66).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.lemehmet.boopstash</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>aps-environment</key>
	<string>$(BOOPSTASH_APS_ENVIRONMENT)</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lemehmet.boopstash</string>
	</array>
</dict>
</plist>
