<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The script service (ADR 0007) runs scripts and JavaScript formatters. It is
  sandboxed with nothing else: no network, no user files, its own empty
  container. Adding a key here needs an ADR, as for the app.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
